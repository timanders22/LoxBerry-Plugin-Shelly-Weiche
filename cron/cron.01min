#!/bin/sh
# Shelly-Weiche - Minutentakt: Lauscher im Hintergrund, dann der Minutenlauf.
# Den bin- und den log-Pfad des Plugins setzt der Installer ein.
#
# 1. Der Lauscher (sw_takt.php --lauschen) bleibt bis zur naechsten vollen Minute plus acht Sekunden am Broker
#    abonniert und endet dann selbst. Er laeuft im Hintergrund, damit dieser Takt nicht auf ihn wartet. Zwei Plaetze
#    mit je einer Sperre im Datenordner: der Lauscher dieser Minute laeuft an, bevor der der vorigen endet - die
#    Shelly-Fuehler melden nur beim kurzen Aufwachen und nicht zurueckbehalten, eine Luecke verloere Meldungen.
#    Sind beide Plaetze belegt, endet der neue sofort. Es gibt keinen Dauerdienst und deshalb keinen Waechter.
# 2. Der Minutenlauf (sw_takt.php) sendet haus/klima (nur mit eingeschaltetem Haken) und den Zaehler und endet nach
#    wenigen Sekunden.
#
# Die Fehlerausgabe geht ins Protokoll, nicht nach /dev/null: LoxBerry ruft jeden Eintrag ohnehin mit
# '> /dev/null 2>&1' auf; ohne eigene Umleitung waere ein Abbruch vor der ersten Protokollzeile stumm (Regeln/03).
# Ist die Fehlerdatei nicht schreibbar, geht die Fehlerausgabe nach /dev/null, und der Lauf findet trotzdem statt.
#
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
( : >>"$ERR" ) 2>/dev/null || ERR=/dev/null
[ -f "REPLACELBPBINDIR/sw_takt.php" ] || exit 0

(
    trap '' HUP
    php "REPLACELBPBINDIR/sw_takt.php" --lauschen >/dev/null 2>>"$ERR"
) </dev/null >/dev/null 2>&1 &

php "REPLACELBPBINDIR/sw_takt.php" >/dev/null 2>>"$ERR"
