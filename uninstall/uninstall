#!/bin/bash
# Shelly-Weiche - Deinstallation
# command <ZUFALLSKENNUNG> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# LoxBerry raeumt config/, log/ und data/ des Plugins selbst weg - aber nur die VERZEICHNISSE. Was daneben liegt
# (Zweitschrift mit dem Aktionstoken, .alt aus einer Neuinstallation, Marke, gesicherter Geraetezustand), raeumt
# dieses Skript ab. Vorher werden die zurueckbehaltenen haus/klima-Themen mit Ruecklesen am Broker geleert - nur
# die, die diese Installation gemerkt hat (data/plugins/<ordner>/haus.json), nie haus/#.
#
# Der Ordnername kommt NUR aus $3 (sonst die Vorgabe), nie aus dem Ablageort: installiert liegt dieses Skript unter
# data/system/uninstall/<name>, und der Ablageort ergaebe den Ordner "system" (Regeln/06).
ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-shellyweiche}"
case "$PFOLDER" in
    ''|*/*|*..*|system)
        echo "<WARNING> Unzulaessiger Ordnername '$PFOLDER' - nichts entfernt."
        exit 0 ;;
esac
BASE="${ARGV5:-$LBHOMEDIR}"
if [ -z "$BASE" ]; then
    SELF=$(cd "$(dirname "$0")" && pwd)
    BASE=$(cd "$SELF/../../.." 2>/dev/null && pwd)
fi
if [ -z "$BASE" ] || [ ! -d "$BASE/config/plugins" ] || [ ! -d "$BASE/data/plugins" ] \
   || [ ! -f "$BASE/config/system/general.json" ]; then
    echo "<WARNING> Kein LoxBerry-Wurzelverzeichnis erkannt ('$BASE') - nichts entfernt."
    echo "<WARNING> Bitte von Hand nachsehen: config/plugins/$PFOLDER.backup.json* und data/plugins/$PFOLDER.*"
    exit 0
fi

SW_TAKT="$BASE/bin/plugins/$PFOLDER/sw_takt.php"
if command -v php >/dev/null 2>&1 && [ -f "$SW_TAKT" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" \
            timeout 60 php "$SW_TAKT" --haus-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$BASE" "LBPPLUGINDIR=$PFOLDER" timeout 60 php "$SW_TAKT" --haus-leeren \
            < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> PHP oder sw_takt.php fehlt - zurueckbehaltene haus/klima-Themen wurden nicht geleert."
fi
CP="$BASE/config/plugins/$PFOLDER"
DP="$BASE/data/plugins/$PFOLDER"
for F in "$CP.backup.json"* "$CP.kaputt.json"* "$DP.upgrade_laeuft" "$DP.haus.json"* "$DP.geraete.json"*; do
    if [ -e "$F" ] || [ -L "$F" ]; then
        rm -f "$F" 2>/dev/null
    fi
done
rm -rf "${DP:?}" 2>/dev/null

# Nachzaehlen: <OK> erst, wenn nichts mehr daliegt (Regeln/06).
REST=""
for F in "$CP.backup.json"* "$CP.kaputt.json"* "$DP.upgrade_laeuft" "$DP.haus.json"* "$DP.geraete.json"* "$DP"; do
    if [ -e "$F" ] || [ -L "$F" ]; then
        REST="$REST $F"
    fi
done
if [ -z "$REST" ]; then
    echo "<OK> Shelly-Weiche entfernt. Neben dem Plugin-Ordner liegt nichts mehr (Zweitschrift mit dem Aktionstoken, .alt, Marke, Geraetezustand)."
else
    echo "<WARNING> Shelly-Weiche entfernt, aber diese Dateien liessen sich nicht loeschen:$REST"
    echo "<WARNING> Sie koennen das Aktionstoken oder Geraetepraefixe enthalten - bitte von Hand entfernen."
fi
echo "<INFO> Die Shelly-Geraete und ihre Abos im MQTT-Gateway bleiben unveraendert."
exit 0
